{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "ignoreDeps": [
    "as-platform/security-pipeline",
    "as-platform/ci-templates"
  ],
  "packageRules": [
    {
      "description": "Mend cannot reach Zot, the scanner image pins are bumped by hand",
      "matchPackageNames": [
        "zot.homelab/**"
      ],
      "enabled": false
    }
  ]
}
